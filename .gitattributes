# Normalize line endings to LF in the repository and working tree.
* text=auto eol=lf

# Windows scripts need CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.icns binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary

# Generated lockfiles: collapsed on GitHub and excluded from language stats.
Cargo.lock      linguist-generated=true
pnpm-lock.yaml  linguist-generated=true

# ImHex pattern language is C-like.
*.pattern linguist-language=C++
