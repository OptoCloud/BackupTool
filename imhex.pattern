// Defines the on-disk layout of our custom BPFS archive format.
//
// This reflects the actual implementation in crates/bpfs-pack (encode) and
// crates/bpfs-read (decode) as of the generational/signed rewrite. Strings
// are generation-local (not a global cross-generation arena): a `string_id`
// on a DirectoryEntry/FileEntry only makes sense within the string table of
// the generation it was declared in.

#pragma endian little

typedef u8  byte;
typedef u64 offset;
typedef u64 timestamp_ms; // 100-nanosecond intervals since UNIX epoch (matches FILETIME-style ticks)
typedef u32 string_id;    // index into the OWNING generation's string table

struct Sha256 {
    u8 digest[32];
}

struct StringEntry {
    u32 offset; // byte offset into this generation's decompressed string heap
    u32 length; // byte length in the heap
};

// count(4) + lookup + size fields + brotli-compressed heap + hash(32).
// Every string referenced by this generation's directories/files/section
// names lives here.
struct StringSection {
    u32 count;
    StringEntry lookup[count];
    u32 uncompressed_size;
    u32 stored_size;
    u8  chunk[stored_size]; // brotli-compressed UTF-8 heap
    Sha256 hash;            // SHA-256 of count..chunk (inclusive)
};

enum CompressionType : u8 {
    None   = 0,
    Lz4    = 1, // reserved, not yet implemented by the encoder/decoder
    Brotli = 3,
    Lzma   = 5, // reserved, not yet implemented by the encoder/decoder
};

enum SignatureType : u32 {
    None    = 0,
    Ed25519 = 1,
};

// 20 bytes. Blobs are content-addressed and may be deduplicated against any
// earlier generation: `generation_idx` names the owning generation and
// `section_idx`/`section_blob_idx` locate it within that generation's data
// sections. A blob physically stored in the *current* generation has
// `generation_idx` equal to that generation's own index. Blobs assigned to
// the same section are concatenated back-to-back in increasing
// `section_blob_idx` order (uncompressed, before the section itself is
// optionally compressed as one unit) -- there is no per-blob offset field;
// offsets are reconstructed by summing preceding blobs' `raw_size`.
struct BlobEntry {
    u64 raw_size;
    u32 generation_idx;
    u32 section_idx;
    u32 section_blob_idx;
};

// 24 bytes. `parent_id == 0xFFFFFFFF` (NO_PARENT) marks a root directory.
// Parents are always declared before their children in the `dirs` array.
struct DirectoryEntry {
    u32 parent_id;
    string_id name;
    timestamp_ms created_at;
    timestamp_ms modified_at;
};

// 24 bytes.
struct FileEntry {
    u32 blob_idx;
    u32 dir_idx;
    string_id name;
    timestamp_ms created_at;
    timestamp_ms modified_at;
};

// name(4) + compression(1) + pad(3) + size(8) + data[size] + hash(32).
// There are always exactly 2 data sections per generation, in this fixed
// order: section_idx 0 = "stored" (CompressionType::None; media/archives/
// anything the compression policy flags as already-incompressible),
// section_idx 1 = "compressed" (CompressionType::Brotli; everything else).
// Both are always present even if empty, so `section_idx` always indexes
// directly into `data_sections` with no remapping.
struct DataSection {
    string_id name;
    CompressionType compression;
    padding[3];
    u64 size;      // compressed (on-disk) length
    u8  data[size];
    Sha256 hash;   // SHA-256 of name..data (inclusive)
};

// One full snapshot. `integrity_hash` is the SHA-256 of every byte of this
// Generation from `created_at` through `previous_integrity_hash` inclusive.
// The signature (if any) signs `integrity_hash` itself and is therefore
// necessarily written *after* it, not covered by it.
struct Generation {
    timestamp_ms created_at;

    u32 file_count;
    u32 dir_count;
    u32 blob_count;

    StringSection  strings;
    BlobEntry      blobs[blob_count];
    DirectoryEntry dirs[dir_count];
    FileEntry      files[file_count];

    u32 data_section_count; // always 2, see DataSection above
    DataSection data_sections[data_section_count];

    Sha256 blobs_hashes[blob_count]; // parallel array: content hash of each blob, for dedup + deep verification

    Sha256 previous_integrity_hash;  // all-zero for generation 0; else previous generation's integrity_hash
    Sha256 integrity_hash;           // SHA-256 of everything above (through previous_integrity_hash)

    SignatureType signature_type;
    u32 signature_size;     // 0 if signature_type == None
    byte signature[signature_size]; // Ed25519: 64 bytes, signs integrity_hash

    u32 suffix; // GENERATION_SUFFIX = 0x42504647 ("BPFG"), marks end of this generation
};

// Top-Level Archive Header (16 bytes)
struct Archive {
    u32 magic;        // Must be 0x42504653 ('BPFS')
    u16 version;      // Archive version (currently 1)
    u16 header_flags; // Feature flags, currently unused
    padding[8];        // Reserved, header sums to 16 bytes
    Generation generations[]; // parsed until EOF
};

Archive archive @ 0x00;
